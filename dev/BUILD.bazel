load("@buildtools//:rules.bzl", "buildifier")
load("@rules_python//python:defs.bzl", "py_binary")

# Format all Bazel files.
buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "fix",
    mode = "fix",
)

py_binary(
    name = "upgrade-dependencies",
    srcs = ["dependencies-upgrade.py"],
    data = [
        "@buildtools//:buildozer",
        "@rules_go//go",
    ],
    main = "dependencies-upgrade.py",
    deps = [
        "//dev/lib:util-python",
        "@pypi//packaging",
        "@pypi//tomlkit",
        "@rules_python//python/runfiles",
    ],
)

# The following 4 platforms may be targeted explicitly from various execution platforms.
# See `rust-cc-toolchains.MODULE.bazel` for more information.

platform(
    name = "x86_64-linux-musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@zig_sdk//libc:musl",
    ],
    visibility = [
        "//operator:__pkg__",
        "//runtime:__pkg__",
    ],
)

platform(
    name = "aarch64-linux-musl",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@zig_sdk//libc:musl",
    ],
)

platform(
    name = "x86_64-macos",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "aarch64-macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)
