# MODULE.bazel-included file
# to set up hermetic CC and Rust toolchains
# to cross-compile from the various supported platforms to other supported platforms.
#
# The following table conveys which target platforms (columns)
# can be compiled from which execution platforms (rows).
#
#     |    | XL | AL | XLm | ALm | XM | AM | WW |
#     | XL | ✔  |    |  ✔  |  ✔  |    |    | ✔  |
#     | AL |    | ✔  |  ✔  |  ✔  |    |    | ✔  |
#     | XM |    |    |  ✔  |  ✔  | ✔  | ✔  | ✔  |
#     | AM |    |    |  ✔  |  ✔  | ✔  | ✔  | ✔  |
#
# - XL = x86_64-linux
# - AL = aarch64-linux
# - XLm = x86_64-linux-musl
# - ALm = aarch64-linux-musl
# - XM = x86_64-macos
# - AM = aarch64-macos
# - WW = wasm32-wasip2

# Download hermetic CC toolchains for each supported execution platform.
zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
zig_toolchains.exec_platform(
    arch = "amd64",
    os = "linux",
)
zig_toolchains.exec_platform(
    arch = "arm64",
    os = "linux",
)
zig_toolchains.exec_platform(
    arch = "amd64",
    os = "macos",
)
zig_toolchains.exec_platform(
    arch = "arm64",
    os = "macos",
)
use_repo(zig_toolchains, "zig_sdk")

# Only register libc-aware toolchains so that zig is used exclusively for musl targets,
# not for host tool builds (where the system toolchain is fine).
# On MacOS, the native clang toolchain can always cross-compile.
register_toolchains("@zig_sdk//libc_aware/toolchain/...")

RUST_EDITION = "2024"

# Must use nightly to take advantage of experimental features (`#![feature]`).
# https://github.com/bazelbuild/rules_rust/blob/0.67.0/rust/private/common.bzl#L36
RUST_NIGHTLY_DATE = "2026-01-01"

RUST_VERSION = "nightly/{}".format(RUST_NIGHTLY_DATE)

# Cross-compile Rust to all supported platforms from any host.
# https://github.com/bazelbuild/rules_rust/blob/0.59.1/examples/musl_cross_compiling/MODULE.bazel
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    sha256s = {
        "{}/rustc-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "66b79c8c1a1b5281f1e44ab49a25b9ab44958670f0f0558ffdc47cc3fc6a306d",
        "{}/clippy-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "fa11fe20bf943deb87dccf764c38f4ff456f1ed869df86687ce9d9f9daf135ad",
        "{}/cargo-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "08ee32c2890f9b65c097bab3084726a1445bdc9e7f4ce26c1fbe2e258f8b7f8a",
        "{}/llvm-tools-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "9beacd171fe0ac5d948cc245886f00c60f879bd3cd52cfde174ae1e79a29aee1",
        "{}/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "62145f32aa8daeadf77c91bfe2b8a95ea0aa9703335cad4dc7a56dd72707e19b",
        "{}/rust-std-nightly-x86_64-unknown-linux-musl.tar.xz".format(RUST_NIGHTLY_DATE): "fe2cb33cc900de3c170ce0147a1f972c6add6a62ea05da28f8c802d66b514dd8",
        "{}/rust-std-nightly-aarch64-unknown-linux-musl.tar.xz".format(RUST_NIGHTLY_DATE): "f7fb95974f23eb935a5e3502021f3c3b85241c0259129e6cbc40a713f3c16d7f",
        "{}/rust-std-nightly-wasm32-wasip2.tar.xz".format(RUST_NIGHTLY_DATE): "65470010b617987dfb1df414ff0223132b1e63a3c4549a15efecec482dcba661",
    },
    versions = [RUST_VERSION],
)

# Execution: x86_64-linux
# Target: x86_64-linux
rust.repository_set(
    name = "rust.x86_64-linux.x86_64-linux",
    edition = RUST_EDITION,
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@zig_sdk//libc:unconstrained",
    ],
    target_triple = "x86_64-unknown-linux-gnu",
    versions = [RUST_VERSION],
)

