use_repo(rust, "rust_toolchains")

# Register musl-targeting Linux Rust toolchains first.
#
# `rules_rust` generates two toolchains per repository_set:
#   1. The "target toolchain" uses the constraints specified by `target_compatible_with`
#      (including `@zig_sdk//libc:variant` constraint).
#   2. The "exec toolchain" derives its target constraints from `exec_triple`
#      (no libc constraint, making it strictly more permissive).
#
# On Linux platforms, both the target toolchain *and* the more-permissive exec toolchain
# would match when building against musl.
# Bazel selects the first matching toolchain,
# so by registering the musl-specific toolchains first,
# we can cause them to be matched preferentially.
#
# https://github.com/bazelbuild/rules_rust/issues/3831
#
# Pattern: rust.{exec_platform}.{target_platform}__{target_triple}__nightly
register_toolchains(
    "@rust_toolchains//:rust.x86_64-linux.x86_64-linux-musl__x86_64-unknown-linux-musl__nightly",
    "@rust_toolchains//:rust.x86_64-linux.aarch64-linux-musl__aarch64-unknown-linux-musl__nightly",
    "@rust_toolchains//:rust.aarch64-linux.x86_64-linux-musl__x86_64-unknown-linux-musl__nightly",
    "@rust_toolchains//:rust.aarch64-linux.aarch64-linux-musl__aarch64-unknown-linux-musl__nightly",
    # All remaining toolchains (non-musl targets and exec toolchains).
    "@rust_toolchains//:all",
)
