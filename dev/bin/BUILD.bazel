load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "upgrade-dependencies",
    srcs = ["dependencies-upgrade.py"],
    data = [
        "@buildtools//:buildozer",
        "@rules_go//go",
    ],
    main = "dependencies-upgrade.py",
    deps = [
        "//dev/lib:util-python",
        "@pypi//packaging",
        "@pypi//tomlkit",
        "@rules_python//python/runfiles",
    ],
)

go_binary(
    name = "expand-sprig",
    embed = [":sprig-expand"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "sprig-expand",
    srcs = ["sprig-expand.go"],
    importpath = "vimana.host/dev/bin",
    visibility = ["//visibility:private"],
    deps = ["@com_github_masterminds_sprig_v3//:sprig"],
)
