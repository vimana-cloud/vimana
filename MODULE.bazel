module(name = "vimana")

bazel_dep(name = "buildifier_prebuilt", version = "8.2.1.1", dev_dependency = True, repo_name = "buildtools")

bazel_dep(name = "bazel_skylib", version = "1.8.2")
single_version_override(
    module_name = "bazel_skylib",
    # TODO: Delete this patch once functionality is upstreamed.
    #   https://github.com/bazelbuild/bazel-skylib/issues/442
    patches = ["//dev/patches:skylib-expand-template-make-variables.patch"],
)
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251127-8cd3749f")
bazel_dep(name = "googleapis-go", version = "1.0.0")
bazel_dep(name = "grpc", version = "1.76.0.bcr.1")
bazel_dep(name = "openssl", version = "3.5.4.bcr.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf")

# TODO: Use a proper release once the prebuilt toolchain is available there.
#   https://github.com/protocolbuffers/protobuf/issues/19558
git_override(
    module_name = "protobuf",
    commit = "cc23698b486e690ea2eb873cc7596a87c74a3ba6",
    remote = "https://github.com/protocolbuffers/protobuf",
    patches = [
        # TODO: Delete this patch once visibility is fixed.
        #   https://github.com/protocolbuffers/protobuf/pull/24895
        "//dev/patches:protobuf-conformance-visibility.patch",
        # These patches patch over apparent breaking changes in protobuf at this commit.
        # They should become obsolete with the next proper release.
        "//dev/patches:protobuf-bzl-visibility.patch",
        "//dev/patches:protobuf-linkarr-attr.patch",
        "//dev/patches:protobuf-prebuilt-linux-aarch64-integrity.patch",
    ],
)

bazel_dep(name = "toolchains_musl", version = "0.1.27")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "rules_nodejs", version = "6.6.2")
bazel_dep(name = "rules_oci", version = "2.2.7")
single_version_override(
    module_name = "rules_oci",
    # TODO: Remove this patch once `rules_oci` moves past 2.2.7.
    #   https://github.com/bazel-contrib/rules_oci/pull/868
    patches = ["//dev/patches:rules-oci-implicit-mediatype.patch"],
)

bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_rust_prost", version = "0.68.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_wasm", version = "2.0.3")
bazel_dep(name = "cri-api")
git_override(
    module_name = "cri-api",
    commit = "c133bdabf253886f640d764d1748aa9ac644ab1c",
    remote = "https://github.com/vimana-cloud/cri-api.git",
)

bazel_dep(name = "rules_k8s")
git_override(
    module_name = "rules_k8s",
    commit = "e5d68de95a980be3339d5240b3d371bfdf799a51",
    remote = "https://github.com/vimana-cloud/rules_k8s.git",
)

environment = use_extension("//dev/rules:environment.bzl", "environment")
use_repo(environment, "environment")

# Register Protobuf toolchains.
register_toolchains("//:protoc-rust-toolchain")

# Build Google API interfaces for Go.
switched_rules = use_extension("@googleapis//:extensions.bzl", "switched_rules")
switched_rules.use_languages(go = True)
use_repo(switched_rules, "com_google_googleapis_imports")

# Rust setup:

RUST_EDITION = "2024"

# Must use nightly to take advantage of experimental features (`#![feature]`).
# https://github.com/bazelbuild/rules_rust/blob/0.67.0/rust/private/common.bzl#L36
RUST_NIGHTLY_DATE = "2025-11-01"

RUST_VERSION = "nightly/{}".format(RUST_NIGHTLY_DATE)

# Make sure we have a toolchain that can cross-compile to x86-64 / Linux / musl.
# https://github.com/bazelbuild/rules_rust/blob/0.59.1/examples/musl_cross_compiling/MODULE.bazel
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    sha256s = {
        "{}/rustc-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "b5eab5cce0269f64caf9c36a607388cb591ccd61f46e886c34350384a039630a",
        "{}/clippy-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "247d18366911dffde2aeb37b4ceb6ff3650f62b00fd82e3ee63cf57256de2545",
        "{}/cargo-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "6f8fa84ec41cda902e5575edcbaec93f8a43b51932d63d1597dc01dc32ee1368",
        "{}/llvm-tools-nightly-x86_64-unknown-linux-gnu.tar.xz".format(RUST_NIGHTLY_DATE): "f0976321dd6bb6e1aca474fe743b55ec176414850ea2f0cda1732f208fc97bd5",
        "{}/rust-std-nightly-x86_64-unknown-linux-musl.tar.xz".format(RUST_NIGHTLY_DATE): "ebb31c22602ca92731efdf78d0d440d68d06d02f527fd6426badec498cad22a5",
        "{}/rust-std-nightly-wasm32-wasip2.tar.xz".format(RUST_NIGHTLY_DATE): "17bbc247c9f980ca7e9e8257d7f30f7d15bdcff14ab8265366a765dacc3420e6",
    },
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_x86_64",
    edition = RUST_EDITION,
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "//dev:unknown",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-gnu",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_aarch64",
    edition = RUST_EDITION,
    exec_triple = "aarch64-unknown-linux-gnu",
    target_compatible_with = [
        "//dev:unknown",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-gnu",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_x86_64",
    target_compatible_with = [
        "//dev:musl",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_linux_aarch64",
    target_compatible_with = [
        "//dev:musl",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_darwin_x86_64",
    edition = RUST_EDITION,
    exec_triple = "x86_64-apple-darwin",
    target_compatible_with = [
        "//dev:musl",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_darwin_aarch64",
    edition = RUST_EDITION,
    exec_triple = "aarch64-apple-darwin",
    target_compatible_with = [
        "//dev:musl",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_wasm32_wasip2",
    edition = RUST_EDITION,
    exec_triple = "x86_64-unknown-linux-gnu",
    target_triple = "wasm32-wasip2",
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl")
toolchains_musl.config(
    extra_target_compatible_with = ["//dev:musl"],
)

crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    # Hardcode all supported Rust toolchains to make Cargo splicing more efficient.
    # https://github.com/bazelbuild/rules_rust/discussions/2259
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "wasm32-wasip2",
        "x86_64-unknown-linux-gnu",
        "x86_64-apple-darwin",
    ],
)

# Generate certain binaries needed for building.
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)

# https://github.com/bazelbuild/rules_rust/issues/1519#issuecomment-2459048249
crate.annotation(
    build_script_data = [
        "@openssl//:gen_dir",
    ],
    build_script_env = {
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_LIB_DIR": "$(location @openssl//:gen_dir)/lib",
        "OPENSSL_INCLUDE_DIR": "$(location @openssl//:gen_dir)/include",
        "OPENSSL_STATIC": "1",
    },
    crate = "openssl-sys",
)

inject_repo(crate, "openssl")

use_repo(crate, "crates")

# Go setup:

# Use a Go toolchain satisfying the SDK version specified in `go.mod`.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Gazelle struggles with this dependency for some reason.
# It generates a `go_proto_library` rule that only uses the gRPC compiler,
# when it needs to use both the gRPC and regular Protobuf compilers.
go_deps.module_override(
    patches = ["//dev/patches:konnectivity-client.patch"],
    path = "sigs.k8s.io/apiserver-network-proxy/konnectivity-client",
)

# Gazelle also struggles with this one, due to a conflict with the `cel-spec` Bzlmod dependency,
# which is pulled in transitively via `grpc`.
# https://github.com/google/cel-go/issues/1184
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "cel.dev/expr",
)
use_repo(
    go_deps,
    "com_github_envoyproxy_gateway",
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "io_k8s_api",
    "io_k8s_apiextensions_apiserver",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
    "io_k8s_sigs_controller_runtime",
    "io_k8s_sigs_gateway_api",
    "io_k8s_utils",
)

# Python setup (for testing):

# https://www.python.org/downloads/
python_version = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = python_version,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = python_version,
    requirements_lock = "requirements.txt.lock",
)
use_repo(pip, "pypi")

# Docker setup

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Distroless base for the operator image.
# https://console.cloud.google.com/artifacts/docker/distroless/us/gcr.io/static
oci.pull(
    name = "distroless-static",
    digest = "sha256:2b7c93f6d6648c11f0e80a48558c8f77885eb0445213b8e69a6a0d7c89fc6ae4",
    image = "gcr.io/distroless/static",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)

# Kicbase is the base for the Minikube node image used in end-to-end tests.
# https://github.com/kubernetes/minikube/blob/v1.36.0/pkg/drivers/kic/types.go#L30
oci.pull(
    name = "kicbase",
    image = "gcr.io/k8s-minikube/kicbase@sha256:6ed579c9292b4370177b7ef3c42cc4b4a6dcd0735a1814916cbc22c8bf38412b",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(
    oci,
    "distroless-static",
    "distroless-static_linux_amd64",
    "distroless-static_linux_arm64_v8",
    "kicbase",
    "kicbase_linux_amd64",
    "kicbase_linux_arm64",
)

# NodeJS setup (for serving documentation with VitePress):

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain()
use_repo(node, "nodejs")
