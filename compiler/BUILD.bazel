load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "compiler",
    srcs = [
        "main.rs",
        "metadata.rs",
        "wit.rs",
    ],
    binary_name = "protoc-gen-vimana",
    compile_data = ["//compiler/wit:deps"],
    rustc_env = {
        "WIT_DEPENDENCIES": "$(location //compiler/wit:deps)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//runtime:metadata-prost",
        "@crates//:anyhow",
        "@crates//:heck",
        "@crates//:include_dir",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:semver",
        "@crates//:wit-encoder",
    ],
)
