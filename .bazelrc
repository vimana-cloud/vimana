# Add custom registries in addition to the BCR.
# Bazel checks these in order from first to last.
common --registry=https://vimana-cloud.github.io/rules_k8s
common --registry=https://bcr.bazel.build

# Enable `--config=macos` automatically on Mac, `--config=linux` on Linux.
common --enable_platform_specific_config

# Use a prebuilt `protoc` binary wherever possible.
common --incompatible_enable_proto_toolchain_resolution=true --@protobuf//bazel/toolchains:prefer_prebuilt_protoc=true

# Ensure a sane C++ standard on all platforms.
build --cxxopt='-std=c++17' --host_cxxopt='-std=c++17'

# Use `--config=release` for optimized builds, without debugging symbols,
# and with build information embedded ("stamped") in the resulting binary.
build:release --compilation_mode=opt --strip=always --stamp

# Building `protoc` from source on Mac requires this minimum OS version.
build:macos --host_cxxopt='-mmacosx-version-min=10.13'

# Use --config=pebble to run end-to-end tests using Pebble
# and a proper ACME flow (better coverage, higher latency).
test:pebble --//cluster/tests:issuer-setup=//cluster/tests/setup:deploy-pebble
