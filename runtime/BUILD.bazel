load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_k8s//:resource.bzl", "oras_push")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load("//dev/rules:platform-binary.bzl", "platform_binary")

# The Vimana runtime implements the K8s CRI.
rust_binary(
    name = "runtime",
    srcs = [
        "containers.rs",
        "cri/image.rs",
        "cri/mod.rs",
        "cri/proxy.rs",
        "cri/runtime.rs",
        "ipam.rs",
        "main.rs",
        "pods.rs",
        "state.rs",
    ],
    binary_name = "vimanad",
    # Disable Rust's self-contained C runtime objects for musl targets
    # so that the hermetic zig CC toolchain provides them instead
    # (avoids duplicate `_start` etc. symbols).
    rustc_flags = select({
        "//dev:musl": ["-Clink-self-contained=no"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":cri-api-prost",
        ":logging",
        ":metadata-prost",
        ":names",
        "//runtime/decode",
        "//runtime/encode",
        "//runtime/host",
        "@crates//:anyhow",
        "@crates//:axum",
        "@crates//:bytes",
        "@crates//:clap",
        "@crates//:futures",
        "@crates//:http",
        "@crates//:hyper-util",
        "@crates//:lazy_static",
        "@crates//:opentelemetry-appender-tracing",
        "@crates//:opentelemetry-stdout",
        "@crates//:opentelemetry_sdk",
        "@crates//:papaya",
        "@crates//:prost",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:rtnetlink",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:wasmtime",
    ],
)

rust_library(
    name = "names",
    srcs = ["names.rs"],
    visibility = [
        ":__subpackages__",
        "//compiler/tests:__pkg__",
    ],
    deps = [
        "@crates//:anyhow",
        "@crates//:lazy_static",
        "@crates//:regex",
    ],
)

rust_test(
    name = "names-test",
    crate = ":names",
)

rust_library(
    name = "logging",
    srcs = ["logging.rs"],
    visibility = [":__subpackages__"],
    deps = [
        ":names",
        "@crates//:tracing",
    ],
)

exports_files(["metadata.proto"])

proto_library(
    name = "metadata-proto",
    srcs = ["metadata.proto"],
    visibility = [":__subpackages__"],
)

rust_prost_library(
    name = "metadata-prost",
    proto = "metadata-proto",
    visibility = [
        ":__subpackages__",
        "//compiler:__subpackages__",
    ],
)

rust_prost_library(
    name = "cri-api-prost",
    proto = "@rules_k8s//:cri-api-proto",
)

# Cross-compile the runtime binary to deploy it to most cloud hardware.
platform_binary(
    name = "runtime.x86_64-linux-musl",
    platform = "//dev:x86_64-linux-musl",
    target = ":runtime",
    visibility = ["//dev/kind:__pkg__"],
)

# Push the built runtime binary to an OCI registry using ORAS.
oras_push(
    name = "artifact-push",
    src = ":runtime.x86_64-linux-musl",
    artifact_type = "application/octet-stream",
    remote_tags = ["latest"],
)
