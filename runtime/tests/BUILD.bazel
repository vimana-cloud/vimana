load("@grpc//bazel:python_rules.bzl", "py_grpc_library", "py_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "success-test",
    srcs = ["success-test.py"],
    data = [
        "//cluster/tests/components:mvp",
        "//cluster/tests/components:mvp-vimana",
    ],
    # Verbosely log wasmtime errors.
    env = {"WASMTIME_BACKTRACE_DETAILS": "1"},
    tags = [
        # https://github.com/bazelbuild/bazel/discussions/25543
        "block-network",
        "requires-fakeroot",
    ],
    deps = [
        ":cri-api-py-pb2",
        ":util",
        "//cluster/tests/components:mvp-py-grpc",
        "//cluster/tests/components:mvp-py-pb2",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "list-test",
    srcs = ["list-test.py"],
    data = [
        "//cluster/tests/components:mvp",
        "//cluster/tests/components:mvp-vimana",
    ],
    tags = [
        # https://github.com/bazelbuild/bazel/discussions/25543
        "block-network",
        "requires-fakeroot",
    ],
    deps = [
        ":cri-api-py-pb2",
        ":util",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "util",
    srcs = ["util.py"],
    data = [
        ":ipam",
        "//cluster/bootstrap:push-image",
        "//runtime",
    ],
    deps = [
        ":cri-api-py-grpc",
        ":cri-api-py-pb2",
        # `typing_extensions` is required for the generated Python gRPC stub.
        "@pypi//typing_extensions",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "ipam",
    srcs = ["ipam.py"],
)

py_proto_library(
    name = "cri-api-py-pb2",
    deps = [":cri-api-proto"],
)

py_grpc_library(
    name = "cri-api-py-grpc",
    srcs = [":cri-api-proto"],
    deps = ["cri-api-py-pb2"],
)

proto_library(
    name = "cri-api-proto",
    # TODO: Use `copy_file` to import the Protobuf source file (see below).
    srcs = ["api.proto"],
)

