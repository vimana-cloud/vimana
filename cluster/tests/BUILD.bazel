load("@environment//:environment.bzl", "localhost")
load("@rules_k8s//:test.bzl", "k8s_cluster_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//cluster/bootstrap:bootstrap.bzl", "self_signed_tls", "vimana_image_push")

vimana_image_push(
    name = "mvp-image-push",
    component = "//cluster/tests/components:mvp",
    metadata = "//cluster/tests/components:mvp-vimana",
    repository = "http://{}:5000/hello-world-example".format(localhost),
    version = "1.0.0",
)

self_signed_tls(
    name = "mvp-certificates",
    domains = [
        "00000000000000000000000000000001.app.vimana.host",
        "mvp.test",
    ],
)

exports_files(["mvp.yaml"])

k8s_cluster_test(
    name = "mvp-test",
    objects = [
        ":mvp.yaml",
        ":mvp-certificates",
    ],
    services = {
        "the-vimana-gateway": [
            "mvp.test",
        ],
    },
    setup = [
        ":mvp-image-push",
    ],
    tags = ["external"],  # Never cache test results.
    test = ":mvp",
)

py_binary(
    name = "mvp",
    srcs = ["mvp-test.py"],
    data = [
        ":mvp-certificates",
    ],
    main = "mvp-test.py",
    deps = [
        "//cluster/tests/components:mvp-py-grpc",
        "//cluster/tests/components:mvp-py-pb2",
    ],
)
