# gRPC service metadata for `AdderService`
# should match `adder.wit`.

messages {
  fields {
    number: 1
    name: "x"
    scalar_coding: FLOAT_IMPLICIT
  }
  fields {
    number: 2
    name: "y"
    scalar_coding: FLOAT_IMPLICIT
  }
}

messages {
  fields {
    number: 1
    name: "result"
    scalar_coding: FLOAT_IMPLICIT
  }
}

services {
  key: "foo.AdderService"
  value {
    methods {
      key: "AddFloats"
      value {
        function: "add-floats"
        arity: UNARY
        request: 0
        response: 1
      }
    }
  }
}
